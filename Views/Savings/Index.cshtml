@using System.Globalization
@using SpendWise.ViewModels
@model List<SavingsContribution>
@{
    ViewData["Title"] = "Savings";
    var inr = new CultureInfo("en-IN");
    var dash = (DashboardViewModel)ViewBag.Dash;
    var barWidth = Math.Min(100, dash.SavingsProgressPercent);
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="mb-0">Savings</h2>
    <a asp-action="Create" class="btn btn-primary">+ Record savings</a>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}

@if (!dash.HasPlan)
{
    <div class="alert alert-warning">
        You have no plan for this month yet.
        <a asp-controller="Plan" asp-action="Index">Set up your Monthly Plan</a> to see a savings goal.
    </div>
}
else
{
    <div class="row g-3 mb-3">
        <div class="col-md-4">
            <div class="card"><div class="card-body">
                <div class="text-muted">Planned savings</div>
                <div class="fs-4">₹@dash.PlannedSavings.ToString("N2", inr)</div>
            </div></div>
        </div>
        <div class="col-md-4">
            <div class="card"><div class="card-body">
                <div class="text-muted">Actual savings</div>
                <div class="fs-4">₹@dash.ActualSavings.ToString("N2", inr)</div>
            </div></div>
        </div>
        <div class="col-md-4">
            <div class="card"><div class="card-body">
                <div class="text-muted">Remaining goal</div>
                <div class="fs-4">₹@dash.RemainingSavingsGoal.ToString("N2", inr)</div>
            </div></div>
        </div>
    </div>

    <div class="mb-1">Progress: @dash.SavingsProgressPercent.ToString("0.##")%</div>
    <div class="progress mb-3" style="height: 24px;">
        <div class="progress-bar bg-success" style="width: @barWidth.ToString("0.##", CultureInfo.InvariantCulture)%"></div>
    </div>

    @if (dash.SavingsGoalReached)
    {
        <div class="alert alert-success">🎉 Savings goal reached!</div>
    }
}

<h5 class="mt-4">This month's contributions</h5>

@if (!Model.Any())
{
    <div class="alert alert-secondary">No savings recorded this month yet.</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead>
                <tr>
                    <th>Date</th>
                    <th>Description</th>
                    <th class="text-end">Amount</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.Date.ToString("dd MMM yyyy")</td>
                        <td>@item.Description</td>
                        <td class="text-end">₹@item.Amount.ToString("N2", inr)</td>
                        <td class="text-end">
                            <form asp-action="Delete" asp-route-id="@item.Id" method="post" class="d-inline"
                                  onsubmit="return confirm('Delete this contribution?');">
                                <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}