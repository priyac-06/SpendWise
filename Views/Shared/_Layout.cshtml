@{
    var ctrl = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    string Active(string name) => ctrl == name ? "active" : "";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - SpendWise</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/SpendWise.styles.css" asp-append-version="true" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/spendwise-theme.css" asp-append-version="true" />
</head>
<body>
    <div class="app-shell">
        <aside class="sidebar">
            <div class="d-flex justify-content-between align-items-center">
                <a class="brand" asp-controller="Home" asp-action="Index">💸 SpendWise</a>
                <button class="btn btn-sm btn-outline-dark d-md-none" type="button"
                        data-bs-toggle="collapse" data-bs-target="#sideNav">Menu</button>
            </div>
            <nav id="sideNav" class="collapse d-md-block mt-3">
                <a class="side-link @Active("Home")" asp-controller="Home" asp-action="Index">Dashboard</a>
                <a class="side-link @Active("Expenses")" asp-controller="Expenses" asp-action="Index">Expenses</a>
                <a class="side-link @Active("Savings")" asp-controller="Savings" asp-action="Index">Savings</a>
                <a class="side-link @Active("Plan")" asp-controller="Plan" asp-action="Index">Monthly Plan</a>
            </nav>
        </aside>

        <main class="content" role="main">
            @RenderBody()
        </main>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>