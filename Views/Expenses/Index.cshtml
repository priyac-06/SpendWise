@using System.Globalization
@model List<Expense>
@{
    ViewData["Title"] = "Expenses";
    var inr = new CultureInfo("en-IN");
    string selectedCat = ViewBag.SelectedCategory ?? "";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="mb-0">Expenses</h2>
    <a asp-action="Create" class="btn btn-primary">+ Add expense</a>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}

<form method="get" class="row g-2 mb-3">
    <div class="col-sm-3">
        <label class="form-label">From</label>
        <input type="date" name="from" value="@ViewBag.From" class="form-control" />
    </div>
    <div class="col-sm-3">
        <label class="form-label">To</label>
        <input type="date" name="to" value="@ViewBag.To" class="form-control" />
    </div>
    <div class="col-sm-3">
        <label class="form-label">Category</label>
        <select name="category" class="form-select">
            <option value="">All</option>
            @foreach (var opt in Html.GetEnumSelectList<ExpenseCategory>())
            {
                <option value="@opt.Value" selected="@(opt.Value == selectedCat)">@opt.Text</option>
            }
        </select>
    </div>
    <div class="col-sm-3 d-flex align-items-end gap-2">
        <button type="submit" class="btn btn-dark">Filter</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Clear</a>
    </div>
</form>

@if (!Model.Any())
{
    <div class="alert alert-secondary">No expenses found. Add your first one!</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead>
                <tr>
                    <th>Date</th>
                    <th>Title</th>
                    <th>Category</th>
                    <th class="text-end">Amount</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.Date.ToString("dd MMM yyyy")</td>
                        <td>@item.Title</td>
                        <td>@Html.DisplayFor(m => item.Category)</td>
                        <td class="text-end">₹@item.Amount.ToString("N2", inr)</td>
                        <td class="text-end">
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-dark">Edit</a>
                            <form asp-action="Delete" asp-route-id="@item.Id" method="post" class="d-inline"
                                  onsubmit="return confirm('Delete this expense?');">
                                <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
            <tfoot>
                <tr>
                    <th colspan="3" class="text-end">Total</th>
                    <th class="text-end">₹@(((decimal)ViewBag.Total).ToString("N2", inr))</th>
                    <th></th>
                </tr>
            </tfoot>
        </table>
    </div>
}
