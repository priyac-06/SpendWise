@using System.Globalization
@using Microsoft.AspNetCore.Mvc.Rendering
@model MonthlyPlan
@{
    ViewData["Title"] = "Monthly Plan";
    var months = Enumerable.Range(1, 12)
        .Select(i => new SelectListItem(
            CultureInfo.InvariantCulture.DateTimeFormat.GetMonthName(i), i.ToString()));
}

<div class="row justify-content-center">
    <div class="col-md-7 col-lg-6">
        <h2 class="mb-3">Monthly Plan</h2>

        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success">@TempData["Success"]</div>
        }

        <form asp-action="Index" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="row">
                <div class="col-6 mb-3">
                    <label asp-for="Month" class="form-label"></label>
                    <select asp-for="Month" asp-items="months" class="form-select"></select>
                    <span asp-validation-for="Month" class="text-danger"></span>
                </div>
                <div class="col-6 mb-3">
                    <label asp-for="Year" class="form-label"></label>
                    <input asp-for="Year" class="form-control" />
                    <span asp-validation-for="Year" class="text-danger"></span>
                </div>
            </div>

            <div class="mb-3">
                <label asp-for="IncomeType" class="form-label"></label>
                <select asp-for="IncomeType" asp-items="Html.GetEnumSelectList<IncomeType>()" class="form-select"></select>
            </div>

            <div class="mb-3">
                <label asp-for="MonthlyIncome" class="form-label"></label>
                <input asp-for="MonthlyIncome" class="form-control" type="number" step="0.01" />
                <span asp-validation-for="MonthlyIncome" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="SavingsGoalType" class="form-label"></label>
                <select asp-for="SavingsGoalType" asp-items="Html.GetEnumSelectList<SavingsGoalType>()" class="form-select"></select>
            </div>

            <div class="mb-3">
                <label asp-for="SavingsGoalValue" class="form-label"></label>
                <input asp-for="SavingsGoalValue" class="form-control" type="number" step="0.01" />
                <span asp-validation-for="SavingsGoalValue" class="text-danger"></span>
                <div class="form-text">Enter rupees for a fixed amount, or a number like 30 for 30%.</div>
            </div>

            <button type="submit" class="btn btn-primary">Save plan</button>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}